NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://planilhainteligente.vercel.app

KIWIFY_PRODUCT_NAME=Aplicativo Inteligente
KIWIFY_INTEGRATION_SECRET=
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TRAVELPAYOUTS_TOKEN=
# Reservado para uma futura ativação de afiliado. Não é usado pelo app atualmente.
TRAVELPAYOUTS_MARKER=
SEARCHAPI_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=gere_com_npx_web-push_generate-vapid-keys
VAPID_PRIVATE_KEY=gere_com_npx_web-push_generate-vapid-keys
VAPID_SUBJECT=mailto:seu-email@dominio.com
CRON_SECRET=gere_um_segredo_longo_e_aleatorio

# Agente de viagens no WhatsApp (painel em /admin/agente)
WHAPI_TOKEN=
WHATSAPP_WEBHOOK_SECRET=gere_um_segredo_longo_e_aleatorio
# Token da sua assinatura do Claude para o worker (npm run agente). Gere com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# WhatsApp local grátis (WAHA) — npm run whatsapp e npm run agente
WAHA_URL=http://localhost:3010
WAHA_API_KEY=gere_um_segredo_longo_e_aleatorio
WAHA_WEBHOOK_PORT=3110

# Transcrição de áudio local e grátis (whisper.cpp + ffmpeg). Opcional: padrão é ~/.vaiviajar/whisper/ggml-small.bin
WHISPER_MODELO=

# Endereço dos links que o agente manda no WhatsApp
LINK_BASE_URL=https://vaiviajar.vercel.app

# Caminho do Chrome/Chromium usado na pesquisa de passagens (padrão: o Google Chrome instalado). Na VPS, aponte para o Chromium instalado.
CHROME_PATH=
